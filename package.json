{
  "name": "security-resource-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && npm run db:migrate:local && wrangler dev --env local --ip 127.0.0.1 --port 8787",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "db:migrate:local": "wrangler d1 migrations apply security-resource-kit-local --local --env local",
    "sources:check": "node scripts/check-sources.mjs",
    "sources:approve": "node scripts/check-sources.mjs --approve",
    "media:prepare": "node scripts/prepare-training-media.mjs",
    "cloud:setup": "node scripts/cloud-setup.mjs",
    "deploy": "npm run check && node scripts/deploy.mjs",
    "moderator:grant": "node scripts/grant-moderator.mjs",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "hono": "4.13.11",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.143.0"
  },
  "overrides": {
    "undici": "7.30.0",
    "sharp": "0.35.5",
    "source-map-js": "https://codeload.github.com/7rulnik/source-map-js/tar.gz/0a1d334fd1e55a47df97fcd60a7915d46df3b08a"
  }
}
